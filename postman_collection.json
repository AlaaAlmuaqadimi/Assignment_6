{
  "info": {
    "name": "MongoDB Assignment API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Explicit Collection - books",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/collection/books",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["collection", "books"]
        }
      }
    },
    {
      "name": "2. Create Implicit Collection - authors",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Author1\",\n    \"nationality\": \"British\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/collection/authors",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["collection", "authors"]
        }
      }
    },
    {
      "name": "3. Create Capped Collection - logs",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/collection/logs/capped",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["collection", "logs", "capped"]
        }
      }
    },
    {
      "name": "4. Create Index on books - title",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/collection/books/index",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["collection", "books", "index"]
        }
      }
    },
    {
      "name": "5. Insert One Book",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Book1\",\n    \"author\": \"Ali\",\n    \"year\": 1937,\n    \"genres\": [\"Fantasy\", \"Adventure\"]\n}"
        },
        "url": {
          "raw": "http://localhost:3000/books",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"]
        }
      }
    },
    {
      "name": "6. Insert Multiple Books",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n    {\n        \"title\": \"Future\",\n        \"author\": \"George Orwell\",\n        \"year\": 2020,\n        \"genres\": [\"Science Fiction\"]\n    },\n    {\n        \"title\": \"To Kill a Mockingbird\",\n        \"author\": \"Harper Lee\",\n        \"year\": 1960,\n        \"genres\": [\"Classic\", \"Fiction\"]\n    },\n    {\n        \"title\": \"Brave New World\",\n        \"author\": \"Aldous Huxley\",\n        \"year\": 2006,\n        \"genres\": [\"Dystopian\", \"Science Fiction\"]\n    }\n]"
        },
        "url": {
          "raw": "http://localhost:3000/books/batch",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", "batch"]
        }
      }
    },
    {
      "name": "7. Insert Log",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"book_id\": \"64b5c0b2f82c4a765ef0\",\n    \"action\": \"borrowed\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/logs",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["logs"]
        }
      }
    },
    {
      "name": "8. Update Book Year",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"year\": 2022\n}"
        },
        "url": {
          "raw": "http://localhost:3000/books/Future",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", "Future"]
        }
      }
    },
    {
      "name": "9. Find Book by Title",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/title?title=Brave New World",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", "title"],
          "query": [
            { "key": "title", "value": "Brave New World" }
          ]
        }
      }
    },
    {
      "name": "10. Find Books by Year Range",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/year?from=1990&to=2010",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", "year"],
          "query": [
            { "key": "from", "value": "1990" },
            { "key": "to", "value": "2010" }
          ]
        }
      }
    },
